{
  "name": "hydra-styling",
  "version": "0.1.0",
  "private": true,
  "description": "Hydra Security's React and Tailwind CSS design system.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @hydra-security/showcase && npm run build:starter",
    "dev": "npm run dev -w @hydra-security/showcase --",
    "test": "npm run test -w @hydra-security/ui",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run build && npm run test:rules",
    "audit": "npm audit --audit-level=moderate",
    "audit:signatures": "npm audit signatures",
    "preview": "npm run preview -w @hydra-security/showcase --",
    "prod": "npm run preview --",
    "build:starter": "tsc -p packages/ui/starter/tsconfig.json --noEmit && vite build packages/ui/starter --outDir ../../../.starter-dist --emptyOutDir",
    "dev:starter": "npm run build -w @hydra-security/ui && vite packages/ui/starter",
    "test:rules": "firebase emulators:exec --project demo-hydra-ui --only firestore,storage \"node --test --test-concurrency=1 tests/firebase-rules.test.mjs\"",
    "emulators": "firebase emulators:start --project demo-hydra-ui --only auth,firestore,storage"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.8.2",
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase-tools": "15.30.2"
  },
  "overrides": {
    "firebase-tools": {
      "csv-parse": "7.0.2",
      "uuid": "11.1.1",
      "@opentelemetry/core": "2.11.0"
    }
  }
}
