# Public Firebase WEB configuration. Never use a service-account private key here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Local emulator mode only works in Vite development, never in a production build.
VITE_FIREBASE_EMULATORS=false
# Optional HTTPS endpoint. Verifies the ID token, handles ownership and data cleanup,
# deletes the Auth account, then returns 2xx. Never point this at an untrusted host.
VITE_ACCOUNT_DELETE_URL=
