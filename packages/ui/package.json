{
  "name": "@hydra-security/ui",
  "version": "0.1.0",
  "description": "Accessible React components and Tailwind CSS tokens for Hydra Security products.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./hydra": {
      "types": "./dist/hydra.d.ts",
      "import": "./dist/hydra.js",
      "require": "./dist/hydra.cjs"
    },
    "./firebase": {
      "types": "./dist/firebase.d.ts",
      "import": "./dist/firebase.js",
      "require": "./dist/firebase.cjs"
    },
    "./firebase-rules/*": "./firebase/*",
    "./styles.css": "./dist/styles.css",
    "./icons/*": "./icons/*"
  },
  "files": [
    "dist",
    "icons",
    "firebase",
    "starter",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "npm run typecheck && npm test && npm run clean && tsup src/index.ts src/hydra.ts src/firebase.ts --format esm,cjs --dts --external react --external react-dom && tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.3 <20",
    "react-dom": ">=18.3 <20"
  },
  "dependencies": {
    "animejs": "4.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "12.19.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "26.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
